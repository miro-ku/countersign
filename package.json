{
  "name": "countersign",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm --dir web dev\"",
    "dev:server": "tsx watch server/index.ts",
    "setup:db": "tsx server/setupDb.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.29.0",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "mongodb": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.14.0"
}
